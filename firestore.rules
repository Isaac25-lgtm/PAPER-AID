rules_version = '2';

// Browsers never talk to Firestore directly: every read and write goes through the PaperAid API,
// which verifies identity and ownership. Denying all client access removes a whole class of
// rule mistakes. The backend's service account is not subject to these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
