# Leave these empty to run locally (local test sign-in against the local backend).
# Set them to your Firebase web app config to use real Firebase Authentication. These values are
# public by design; never put API keys for OpenAI, Anthropic or payments in any VITE_ variable.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_APPCHECK_SITE_KEY=
