# Copy to .env. Everything here runs locally with no accounts; the production values are in docs/deployment.md.
ENV=local
DATA_DIR=.data

# AI providers. Both keys are required; without them AI Check, Check + Refine and University
# templates show as not set up and cannot be quoted or run. Never paste keys anywhere else.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# The permanent algorithm uses two fixed roles (references are "provider:model-id"):
#   LEAD   (GPT-6 Sol)       final guidance and approval
#   WRITER (Claude Opus 5.5) independent guidance and approval
# Luna handles routine work; Sonnet writes and repairs. Both check writing patterns.
# University templates use the same loop over formatting rules.
LEAD_MODEL=openai:gpt-6-sol
WRITER_MODEL=anthropic:claude-opus-5-5
AI_CHECK_MODEL=openai:gpt-6-luna
AI_CHECK_PEER_MODEL=anthropic:claude-sonnet-5-5
ROUTINE_MODEL=openai:gpt-6-luna
DRAFTING_MODEL=anthropic:claude-sonnet-5-5
REQUIRE_DUAL_APPROVAL=true
# Prices for GPT-6 Sol and Claude are built in. Override only if they change, e.g.
# MODEL_PRICES={"openai:gpt-6-sol": [2, 10, 0.2]}  (input, output, cached input per million tokens)
WRITER_EFFORT=medium

# Product rules
# Credits: false = testing mode (no balance needed, nothing charged, prices still shown).
CREDITS_ENABLED=true
PAYMENTS_ENABLED=false
QUEUE_CONCURRENCY=5
MAX_ACTIVE_JOBS_PER_USER=3
RETENTION_DAYS=30
MAX_WORDS=25000

# Local test sign-in: these emails get admin access. Production uses the Firebase `admin` custom claim.
ADMIN_EMAILS=["you@example.com"]
