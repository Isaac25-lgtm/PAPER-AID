# Copy to .env. Everything here runs locally with no accounts; the production values are in docs/deployment.md.
ENV=local
DATA_DIR=.data

# AI: the Gemini workflow on Vertex AI (owner decision 2026-10-07). New jobs run every AI step on
# Gemini in its own Google Cloud project, signed in with Application Default Credentials: locally
# `gcloud auth application-default login`; on Cloud Run the worker's own service account. No key.
# Never set GOOGLE_CLOUD_PROJECT for this: Google libraries read it, and the app's resources stay in GCP_PROJECT.
VERTEX_PROJECT=paperaid
VERTEX_LOCATION=global
# Each stage's model and thinking level (MINIMAL | LOW | MEDIUM | HIGH). Defaults shown; each model must be
# in app/ai/gemini.py's verified registry with a published price in app/ai/vertex_pricing.py.
# INTAKE_MODEL=gemini-3.5-flash-lite          INTAKE_THINKING=LOW
# PLANNER_MODEL=gemini-3.8-flash              PLANNER_THINKING=HIGH
# RESEARCH_MODEL=gemini-3.8-flash             RESEARCH_THINKING=MEDIUM
# EXECUTION_MODEL=gemini-3.8-flash            EXECUTION_THINKING=MEDIUM
# FIRST_AUDIT_MODEL=gemini-3.8-flash          FIRST_AUDIT_THINKING=HIGH
# SECOND_CHECK_MODEL=gemini-3.5-flash-lite    SECOND_CHECK_THINKING=MEDIUM
# PREMIUM_AUDIT_MODEL=gemini-3.1-pro-preview  PREMIUM_AUDIT_THINKING=HIGH
# FIX_MODEL=gemini-3.8-flash                  FIX_THINKING=MEDIUM
# FINAL_SIGNOFF_MODEL=gemini-3.8-flash        FINAL_SIGNOFF_THINKING=HIGH
# GEMINI_FALLBACKS={"premium_audit":["first_audit"]}  # stages only, used on outages; never dearer
# VERTEX_SEARCH_ENABLED=false  # switches Google Search grounding off: Source Check and research show as not set up

# Jobs priced before the Gemini workflow keep their own routes and need these (GEMINI_WORKFLOW=false
# brings the earlier OpenAI/Anthropic algorithm back for new jobs). Never paste keys anywhere else.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LEAD_MODEL=openai:gpt-6-sol
WRITER_MODEL=anthropic:claude-opus-5-5
AI_CHECK_MODEL=openai:gpt-6-luna
AI_CHECK_PEER_MODEL=anthropic:claude-sonnet-5-5
ROUTINE_MODEL=openai:gpt-6-luna
DRAFTING_MODEL=anthropic:claude-sonnet-5-5
REQUIRE_DUAL_APPROVAL=true
WRITER_EFFORT=medium

# Product rules
# Credits: false = testing mode (no balance needed, nothing charged, prices still shown).
CREDITS_ENABLED=true
PAYMENTS_ENABLED=false
QUEUE_CONCURRENCY=5
MAX_ACTIVE_JOBS_PER_USER=3
RETENTION_DAYS=30
MAX_WORDS=25000

# Local test sign-in: these emails get admin access. Production uses the Firebase `admin` custom claim.
ADMIN_EMAILS=["you@example.com"]
